.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD}
.IF ERRORCODE <> 0 THEN .QUIT 12
.SET ERROROUT STDOUT
.SET WIDTH 254
.SET TITLEDASHES OFF
SET SESSION DATEFORM = ANSIDATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT batch_date, status, last_step_cd
FROM nvb_edw.etl_batch_control
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .GOTO register_batch
.GOTO batch_ready
.LABEL register_batch
INSERT INTO nvb_edw.etl_batch_control
    (batch_date, job_name, status, row_count)
VALUES (DATE '2025-06-30', 'NIGHTLY', 'OPEN', 0);
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL batch_ready
UPDATE nvb_edw.etl_batch_control
SET status = 'RUNNING', last_step_cd = '05_customer_segment'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_customer_control AS
(
    SELECT c.customer_id, COUNT(a.account_id) AS accounts
    FROM nvb_edw.dim_customer AS c
    LEFT JOIN nvb_edw.dim_account AS a ON c.customer_id = a.customer_id
    GROUP BY 1
) WITH DATA PRIMARY INDEX (customer_id) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 customer_id FROM vt_customer_control WHERE customer_id <= 0;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
CALL nvb_edw.customer_segment(DATE '2025-06-30');
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 c.customer_id
FROM vt_customer_control AS c
LEFT JOIN nvb_mart.mart_customer_segment AS s ON c.customer_id = s.customer_id
WHERE s.customer_id IS NULL OR s.spend < 0
   OR s.segment NOT IN ('DORMANT', 'PREMIUM', 'ACTIVE', 'OCCASIONAL');
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
COLLECT STATISTICS COLUMN (segment) ON nvb_mart.mart_customer_segment;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT segment, COUNT(*) AS customers, SUM(spend) AS debit_spend
FROM nvb_mart.mart_customer_segment GROUP BY 1 ORDER BY 1;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL rejected
.REMARK 'Control failure: retain delivery and request log; do not publish.'
.LABEL failed
.EXPORT RESET
UPDATE nvb_edw.etl_batch_control
SET status = 'FAILED', last_step_cd = '05_customer_segment'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .QUIT 99
.LOGOFF
.QUIT 12
