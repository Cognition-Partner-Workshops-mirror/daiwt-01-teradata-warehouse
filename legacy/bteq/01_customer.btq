.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD}
.IF ERRORCODE <> 0 THEN .QUIT 12
.SET ERROROUT STDOUT
.SET WIDTH 254
.SET TITLEDASHES OFF
SET SESSION DATEFORM = ANSIDATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT batch_date, status, last_step_cd
FROM nvb_edw.etl_batch_control
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .GOTO register_batch
.GOTO batch_ready
.LABEL register_batch
INSERT INTO nvb_edw.etl_batch_control
    (batch_date, job_name, status, row_count)
VALUES (DATE '2025-06-30', 'NIGHTLY', 'OPEN', 0);
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL batch_ready
UPDATE nvb_edw.etl_batch_control
SET status = 'RUNNING', last_step_cd = '01_customer'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_customer_raw AS
(
    SELECT
        TRYCAST(TRIM(customer_id) AS INTEGER) AS customer_id,
        TRIM(OREPLACE(customer_name, ' ', ' ')) AS customer_name,
        TRYCAST(TRIM(branch_id) AS INTEGER) AS branch_id,
        TRIM(OREPLACE(town, ' ', ' ')) AS town,
        TRYCAST(TRIM(updated_at) AS TIMESTAMP(0)) AS updated_at,
        HASHROW(customer_id, customer_name, town) AS source_hash
    FROM nvb_stg.customer_feed
) WITH DATA PRIMARY INDEX (customer_id) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed

SELECT TOP 1 r.customer_id, r.branch_id
FROM vt_customer_raw AS r
LEFT JOIN nvb_edw.dim_branch AS b ON r.branch_id = b.branch_id
WHERE r.customer_id IS NULL OR r.customer_id <= 0
   OR r.customer_name IS NULL OR r.customer_name = ''
   OR r.updated_at IS NULL OR b.branch_id IS NULL;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_customer AS
(
    SELECT customer_id, customer_name, branch_id, town, updated_at
    FROM vt_customer_raw
    QUALIFY ROW_NUMBER() OVER
    (
        PARTITION BY customer_id
        ORDER BY updated_at DESC, customer_name DESC, town DESC, branch_id DESC
    ) = 1
) WITH DATA PRIMARY INDEX (customer_id) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed
COLLECT STATISTICS COLUMN (customer_id) ON vt_customer;
.IF ERRORCODE <> 0 THEN .GOTO failed

MERGE INTO nvb_edw.dim_customer AS t
USING vt_customer AS s ON t.customer_id = s.customer_id
WHEN MATCHED THEN UPDATE SET
    customer_name = s.customer_name, branch_id = s.branch_id,
    town = s.town, updated_at = s.updated_at,
    batch_id = 20250630, load_ts = TIMESTAMP '2025-06-30 23:00:00'
WHEN NOT MATCHED THEN INSERT
    (customer_id, customer_name, branch_id, town, updated_at)
VALUES
    (s.customer_id, s.customer_name, s.branch_id, s.town, s.updated_at);
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .REMARK 'Customer delivery made no changes.'
COLLECT STATISTICS COLUMN (branch_id) ON nvb_edw.dim_customer;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL rejected
.REMARK 'Control failure: retain delivery and request log; do not publish.'
.LABEL failed
.EXPORT RESET
UPDATE nvb_edw.etl_batch_control
SET status = 'FAILED', last_step_cd = '01_customer'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .QUIT 99
.LOGOFF
.QUIT 12
