.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD}
.IF ERRORCODE <> 0 THEN .QUIT 12
.SET ERROROUT STDOUT
.SET WIDTH 254
.SET TITLEDASHES OFF
SET SESSION DATEFORM = ANSIDATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT batch_date, status, last_step_cd
FROM nvb_edw.etl_batch_control
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .GOTO register_batch
.GOTO batch_ready
.LABEL register_batch
INSERT INTO nvb_edw.etl_batch_control
    (batch_date, job_name, status, row_count)
VALUES (DATE '2025-06-30', 'NIGHTLY', 'OPEN', 0);
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL batch_ready
UPDATE nvb_edw.etl_batch_control
SET status = 'RUNNING', last_step_cd = '10_close_batch'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_close_control AS
(
    SELECT COUNT(*) AS payment_count, SUM(amount) AS net_amount
    FROM nvb_edw.fct_transaction
) WITH DATA NO PRIMARY INDEX ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 w.payment_count
FROM vt_close_control AS w
CROSS JOIN
(
    SELECT SUM(txn_count) AS payment_count, SUM(net_amount) AS net_amount
    FROM nvb_mart.mart_channel_daily
) AS m
WHERE w.payment_count <> m.payment_count OR w.net_amount <> m.net_amount
   OR m.payment_count IS NULL;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
UPDATE nvb_edw.etl_batch_control
SET status = 'COMPLETE', last_step_cd = '10_close_batch',
    row_count = (SELECT payment_count FROM vt_close_control)
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected
COLLECT STATISTICS COLUMN (batch_date, status) ON nvb_edw.etl_batch_control;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT REPORT FILE = control_reports/nightly_release.txt
SELECT batch_date, job_name, status, row_count, last_step_cd, load_ts
FROM nvb_edw.etl_batch_control WHERE batch_date = DATE '2025-06-30';
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL rejected
.REMARK 'Control failure: retain delivery and request log; do not publish.'
.LABEL failed
.EXPORT RESET
UPDATE nvb_edw.etl_batch_control
SET status = 'FAILED', last_step_cd = '10_close_batch'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .QUIT 99
.LOGOFF
.QUIT 12
