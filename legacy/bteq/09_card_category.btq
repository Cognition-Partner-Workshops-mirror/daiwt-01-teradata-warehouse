.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD}
.IF ERRORCODE <> 0 THEN .QUIT 12
.SET ERROROUT STDOUT
.SET WIDTH 254
.SET TITLEDASHES OFF
SET SESSION DATEFORM = ANSIDATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT batch_date, status, last_step_cd
FROM nvb_edw.etl_batch_control
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .GOTO register_batch
.GOTO batch_ready
.LABEL register_batch
INSERT INTO nvb_edw.etl_batch_control
    (batch_date, job_name, status, row_count)
VALUES (DATE '2025-06-30', 'NIGHTLY', 'OPEN', 0);
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL batch_ready
UPDATE nvb_edw.etl_batch_control
SET status = 'RUNNING', last_step_cd = '09_card_category'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_card_control AS
(
    SELECT m.category, COUNT(*) AS txn_count, SUM(-t.amount) AS spend
    FROM nvb_edw.fct_transaction AS t
    JOIN nvb_edw.dim_merchant AS m ON t.merchant_id = m.merchant_id
    WHERE t.channel = 'CARD' AND t.amount < 0
    GROUP BY 1
) WITH DATA PRIMARY INDEX (category) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 category FROM vt_card_control WHERE spend < 0 OR category IS NULL;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
EXEC nvb_edw.card_category(DATE '2024-01-01', DATE '2025-06-30');
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 w.category FROM vt_card_control AS w
LEFT JOIN nvb_mart.mart_card_spend_category AS m ON w.category = m.category
WHERE m.category IS NULL OR m.spend <> w.spend OR m.txn_count <> w.txn_count;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
COLLECT STATISTICS COLUMN (category) ON nvb_mart.mart_card_spend_category;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT category, spend, txn_count,
       spend / NULLIFZERO(SUM(spend) OVER ()) AS share_of_debit_spend
FROM nvb_mart.mart_card_spend_category ORDER BY spend DESC;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL rejected
.REMARK 'Control failure: retain delivery and request log; do not publish.'
.LABEL failed
.EXPORT RESET
UPDATE nvb_edw.etl_batch_control
SET status = 'FAILED', last_step_cd = '09_card_category'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .QUIT 99
.LOGOFF
.QUIT 12
