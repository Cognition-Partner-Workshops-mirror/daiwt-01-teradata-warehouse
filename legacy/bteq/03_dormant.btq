.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD}
.IF ERRORCODE <> 0 THEN .QUIT 12
.SET ERROROUT STDOUT
.SET WIDTH 254
.SET TITLEDASHES OFF
SET SESSION DATEFORM = ANSIDATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT batch_date, status, last_step_cd
FROM nvb_edw.etl_batch_control
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT = 0 THEN .GOTO register_batch
.GOTO batch_ready
.LABEL register_batch
INSERT INTO nvb_edw.etl_batch_control
    (batch_date, job_name, status, row_count)
VALUES (DATE '2025-06-30', 'NIGHTLY', 'OPEN', 0);
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL batch_ready
UPDATE nvb_edw.etl_batch_control
SET status = 'RUNNING', last_step_cd = '03_dormant'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 1 THEN .GOTO rejected

CREATE VOLATILE TABLE vt_account_control AS
(
    SELECT a.account_id, a.customer_id, a.dormant_flag,
           MAX(t.txn_date) AS last_payment_date
    FROM nvb_edw.dim_account AS a
    LEFT JOIN nvb_edw.fct_transaction AS t ON a.account_id = t.account_id
    GROUP BY 1, 2, 3
) WITH DATA PRIMARY INDEX (account_id) ON COMMIT PRESERVE ROWS;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 a.account_id FROM vt_account_control AS a
LEFT JOIN nvb_edw.dim_customer AS c ON a.customer_id = c.customer_id
WHERE c.customer_id IS NULL;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
CALL nvb_edw.flag_dormant(DATE '2025-06-30');
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT TOP 1 a.account_id
FROM nvb_edw.dim_account AS a
INNER JOIN vt_account_control AS w ON a.account_id = w.account_id
WHERE a.dormant_flag <>
    CASE WHEN w.last_payment_date IS NULL
               OR w.last_payment_date <= ADD_MONTHS(DATE '2025-06-30', -6)
         THEN 'Y' ELSE 'N' END;
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO rejected
COLLECT STATISTICS COLUMN (dormant_flag) ON nvb_edw.dim_account;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT dormant_flag, COUNT(*) AS accounts FROM nvb_edw.dim_account GROUP BY 1;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL rejected
.REMARK 'Control failure: retain delivery and request log; do not publish.'
.LABEL failed
.EXPORT RESET
UPDATE nvb_edw.etl_batch_control
SET status = 'FAILED', last_step_cd = '03_dormant'
WHERE batch_date = DATE '2025-06-30' AND job_name = 'NIGHTLY';
.IF ERRORCODE <> 0 THEN .QUIT 99
.LOGOFF
.QUIT 12
